<?xml version="1.0"?>
<!-- Optional QSFP-DD cage approx: 4-box square hole (robosuite-style).
     Hole opening: 19.0 x 9.0 mm, depth 50 mm. Fixed on table; insert along -Z. -->
<robot name="qsfp_dd_hole_plate">
  <link name="plate_link">
    <inertial>
      <origin xyz="0 0 -0.025" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>

    <!-- Left wall (-X), spans full outer Y -->
    <visual>
      <origin xyz="-0.017 0 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.015 0.039 0.05"/></geometry>
      <material name="gray"><color rgba="0.55 0.55 0.55 1"/></material>
    </visual>
    <collision>
      <origin xyz="-0.017 0 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.015 0.039 0.05"/></geometry>
    </collision>

    <!-- Right wall (+X) -->
    <visual>
      <origin xyz="0.017 0 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.015 0.039 0.05"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.017 0 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.015 0.039 0.05"/></geometry>
    </collision>

    <!-- Front wall (+Y), spans hole width only -->
    <visual>
      <origin xyz="0 0.012 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.019 0.015 0.05"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0.012 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.019 0.015 0.05"/></geometry>
    </collision>

    <!-- Back wall (-Y) -->
    <visual>
      <origin xyz="0 -0.012 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.019 0.015 0.05"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 -0.012 -0.025" rpy="0 0 0"/>
      <geometry><box size="0.019 0.015 0.05"/></geometry>
    </collision>

    <!-- Bottom floor (blind hole) -->
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.049 0.039 0.005"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.049 0.039 0.005"/></geometry>
    </collision>
  </link>
</robot>
